# ===========================================
# Next.js Environment Variables
# ===========================================
# Copy this file to .env.local and update the values
# These are client-side environment variables for the Next.js app

# Supabase API URL (Kong API Gateway)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Supabase Anonymous Key (public, safe for browser)
# IMPORTANT: This must be signed with the same JWT_SECRET as in your .env file
# If you regenerate JWT_SECRET, you MUST regenerate this token using setup.sh
NEXT_PUBLIC_SUPABASE_ANON_KEY=REDACTED_ANON_KEY

# Supabase Service Role Key (for server-side admin operations)
# IMPORTANT: Keep this secret! Never expose to the browser.
# This must be signed with the same JWT_SECRET as in your .env file
SUPABASE_SERVICE_ROLE_KEY=REDACTED_SERVICE_ROLE_KEY

# Optional: Resend API key for email notifications
# RESEND_API_KEY=your_resend_api_key_here

# ===========================================
# IMPORTANT: JWT Token Generation
# ===========================================
# If you change JWT_SECRET in .env, you MUST regenerate these tokens!
# 
# The setup.sh script automatically generates tokens that match your JWT_SECRET.
# 
# To manually generate tokens, see docs/DATABASE_SETUP.md
