# ===========================================
# Next.js Environment Variables
# ===========================================
# Copy this file to .env.local and update the values
# Run ./setup.sh to auto-generate these values

# Supabase API URL (Kong API Gateway)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Supabase Anonymous Key (public, safe for browser)
# Get this from .env (ANON_KEY) after running setup.sh
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key-from-env>

# Supabase Service Role Key (server-side only, never expose to browser)
# Get this from .env (SERVICE_ROLE_KEY) after running setup.sh
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key-from-env>

# Optional: Resend API key for email notifications
# RESEND_API_KEY=your_resend_api_key_here
